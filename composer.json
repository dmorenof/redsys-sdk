{
    "name": "dmorenof/redsys-sdk",
    "description": "Redsys (TPV Virtual) for PHP 8.4: redirection and REST payments with 3-D Secure, signed requests and verified answers, on dmorenof/sdk-runtime.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "dmorenof/sdk-runtime": "^1.12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Redsys\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Redsys\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
